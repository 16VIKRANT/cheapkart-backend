PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/cheapkart?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Admin login: username=admin, password=admin on first run. Set these before
# first startup to use a stronger password; the admin is seeded only if absent.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@cheapkart.local
ADMIN_ALERT_EMAIL=vikrant.raut1598@gmail.com
SELLER_ALERT_EMAIL=vvraut010@gmail.com

# Amazon SES email notifications
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=<iam-access-key-id>
AWS_SECRET_ACCESS_KEY=<iam-secret-access-key>
SES_FROM_EMAIL=<verified-sender-address>

# Solace PubSub+ Cloud MQTT over TLS (port 8883)
SOLACE_MQTT_URL=mqtts://<broker-host>:8883
SOLACE_MQTT_USERNAME=<client-username>
SOLACE_MQTT_PASSWORD=<client-password>
SOLACE_MQTT_CLIENT_ID=cheapkart-backend
SOLACE_ORDERS_TOPIC=ecommerce/orders/placed
SOLACE_INVENTORY_TOPIC=ecommerce/inventory/updated
